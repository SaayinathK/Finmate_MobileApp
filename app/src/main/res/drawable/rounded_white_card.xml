<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Background Color -->
    <solid android:color="@color/glass_surface" />

    <!-- Rounded Corners -->
    <corners android:radius="16dp" />

    <!-- Optional: border -->
    <stroke
        android:width="1dp"
        android:color="#D6DEEF" />

    <!-- Optional: shadow effect (for pre-Lollipop look) -->
    <padding
        android:left="8dp"
        android:top="8dp"
        android:right="8dp"
        android:bottom="8dp" />
</shape>
