<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.FinanceTracker" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/blue_700</item>
        <item name="colorPrimaryVariant">@color/blue_700</item>
        <item name="colorSecondary">@color/green_500</item>
        <item name="colorSurface">@color/wallet_surface</item>
        <item name="colorOnSurface">@color/ink_primary</item>
        <item name="android:textColorPrimary">@color/ink_primary</item>
        <item name="android:textColorSecondary">@color/ink_secondary</item>
        <item name="android:colorBackground">@color/app_background</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="android:colorAccent">@color/blue_500</item>
        <item name="android:statusBarColor" tools:targetApi="l">@color/app_background</item>
        <item name="android:navigationBarColor" tools:targetApi="l">@color/app_background</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">@bool/wallet_light_bars</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">@bool/wallet_light_bars</item>
        <item name="android:windowBackground">@color/app_background</item>
        <item name="android:windowAnimationStyle">@style/WalletWindowAnimation</item>
    </style>
</resources>
